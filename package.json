{
  "name": "demeter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/verify-deployment-env.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --write app/student/page.tsx && node -e \"const fs=require('fs');const b=Buffer.from(fs.readFileSync('app/student/page.tsx')).toString('base64');console.log('B64_START');for(let i=0;i<b.length;i+=1000)console.log('B64:'+b.slice(i,i+1000));console.log('B64_END');process.exit(1)\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.0"
  }
}
